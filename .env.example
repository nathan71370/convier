# Nom d'hôte servi par Traefik. Il alimente à la fois la règle de routage
# Host(...) et l'origine publique du site, pour que les deux ne divergent pas.
CONVIER_HOST=convier.limperiam.com

# À ne définir que si l'origine publique diffère de https://CONVIER_HOST
# (autre schéma, port non standard). Sinon, laisse cette ligne de côté.
# SITE_URL=https://convier.limperiam.com

# Fichier SQLite local par défaut. Pour passer sur Turso :
#   DATABASE_URL=libsql://ma-base-mon-org.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=
