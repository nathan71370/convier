# Origine publique du site, sans slash final.
# Elle sert aux liens montrés à l'organisateur et à l'URL inscrite dans le
# fichier .ics — mets l'adresse que tes invités ouvrent réellement.
# Laissée vide, elle est déduite des en-têtes de la requête.
SITE_URL=https://convier.mondomaine.fr

# Fichier SQLite local par défaut. Pour passer sur Turso :
#   DATABASE_URL=libsql://ma-base-mon-org.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Port exposé sur l'hôte par compose.yaml (le conteneur écoute toujours 3000).
HOST_PORT=3000
