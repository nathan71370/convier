# Nom d'hôte servi par Traefik. Il alimente à la fois la règle de routage
# Host(...) et l'origine publique du site, pour que les deux ne divergent pas.
CONVIER_HOST=convier.limperiam.com

# Sel serveur mêlé aux codes de connexion avant empreinte. OBLIGATOIRE.
# Génère-le une fois : openssl rand -hex 32
# Le changer invalide les codes en cours, pas les sessions ouvertes.
AUTH_SECRET=

# Fichier des adresses autorisées à CRÉER un événement, partagé entre tes apps.
# Adresses séparées par des virgules, des points-virgules ou des retours à la
# ligne ; les lignes commençant par # sont ignorées. Relu à chaque modification.
# Absent ou illisible : personne ne peut créer, le reste continue de marcher.
WHITELIST_FILE=/whitelist.txt

# Envoi des codes de connexion. Toutes absentes, le code est écrit dans les
# logs du conteneur au lieu d'être envoyé — pratique pour un premier essai.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Convier <no-reply@limperiam.com>

# Albums photo partagés. Absentes, la case et le bouton n'apparaissent pas.
IMMICH_URL=https://immich.limperiam.com
IMMICH_API_KEY=

# Fichier SQLite local par défaut. Pour passer sur Turso :
#   DATABASE_URL=libsql://ma-base-mon-org.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=
